# Copy to .env (chmod 600). Never commit .env.
# Postgres connection URL (user, password, host, database; add ?sslmode=require on Azure).
DATABASE_URL=
SITE_URL=https://furp.org
# Postmark server API token for the contact form (Postmark > Servers > API Tokens).
POSTMARK_SERVER_TOKEN=
# Any long random string; signs the contact form's timestamp field.
CONTACT_FORM_SECRET=
# Anthropic API key for Ask (plain-English search, /ask). Leave empty to switch Ask off.
ANTHROPIC_API_KEY=
