# /etc/cron.d/np-linkedin: daily FURP post to the owner's LinkedIn (app/linkedin.py), every day (owner, 2026-10-23).
# The server clock is America/Chicago: 06:15 draft (emailed right away during the review week), 07:30 post (owner,
# 2026-10-27; was 08:30), retried hourly to 11:30 until the draft email has been out 30 minutes.
SHELL=/bin/sh
PATH=/usr/bin:/bin
15 6 * * * michael cd /home/michael/np-explorer && set -a && . ./.env && set +a && .venv/bin/python -m app.linkedin draft >> /var/log/np-explorer/linkedin.log 2>&1
30 7,8,9,10,11 * * * michael cd /home/michael/np-explorer && set -a && . ./.env && set +a && .venv/bin/python -m app.linkedin post >> /var/log/np-explorer/linkedin.log 2>&1
